        <!-- سوشل میڈیا لنکس -->
        <div class="links-container">
            <a href="https://www.facebook.com" target="_blank" class="social-btn facebook">فیس بک (Facebook)</a>
            <a href="https://www.youtube.com/@MaqsoodAli489" target="_blank" class="social-btn youtube">یوٹیوب (YouTube)</a>
            <a href="https://www.tiktok.com/@hajimaqsoodali1" target="_blank" class="social-btn tiktok">ٹک ٹاک (TikTok)</a>
            <a href="https://www.instagram.com" target="_blank" class="social-btn instagram">انسٹاگرام (Instagram)</a>
            <a href="https://wa.me/923430450007" target="_blank" class="social-btn whatsapp">واٹس ایپ بزنس (WhatsApp)</a>
        </div>

        <div class="footer">
            &copy; 2026 دل جان 1400. جملہ حقوق محفوظ ہیں۔
        </div>
    </div>

</body>
