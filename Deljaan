<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دل جان 1400 آفیشل پورٹل</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #111;
            color: #fff;
            text-align: center;
        }

        header {
            background-color: #0f5132;
            padding: 15px;
            border-bottom: 3px solid #ffc107;
        }

        .logo-area {
            font-size: 26px;
            font-weight: bold;
            color: #ffc107;
        }

        .container {
            max-width: 800px;
            margin: 20px auto;
            padding: 15px;
        }

        /* ٹی وی والی چلتی پٹی */
        .ticker-wrap {
            width: 100%;
            background-color: #ffc107;
            color: #000;
            overflow: hidden;
            white-space: nowrap;
            padding: 10px 0;
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 25px;
        }

        .ticker-content {
            display: inline-block;
            padding-right: 100%;
            animation: ticker 25s linear infinite;
        }

        @keyframes ticker {
            0% { transform: translate3d(100%, 0, 0); }
            100% { transform: translate3d(-100%, 0, 0); }
        }

        /* ویڈیو اپلوڈ اور شیئرنگ ہب */
        .free-hub {
            background: #222;
            border: 2px solid #ffc107;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 30px;
        }

        .file-input {
            margin: 15px 0;
            padding: 10px;
            background: #333;
            border: 1px dashed #ffc107;
            color: #fff;
            border-radius: 5px;
            width: 100%;
            max-width: 400px;
        }

        .btn-send {
            background-color: #0088cc;
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 25px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-send:hover {
            background-color: #0077b3;
            transform: scale(1.05);
        }

        /* 6 سوشل لنکس */
        .social-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 12px;
        }

        .social-btn {
            background-color: #333;
            border: 2px solid #444;
            color: #fff;
            padding: 15px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            transition: 0.3s;
        }

        .social-btn:hover {
            transform: translateY(-5px);
            background-color: #fff;
            color: #000;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo-area">دل جان 1400 آفیشل پورٹل</div>
    </header>

    <!-- چلتی پٹی -->
    <div class="ticker-wrap">
        <div class="ticker-content">
            ★★★ دل جان 1400 ویلفیئر ٹرسٹ: غریب اور مستحقین کے لیے راشن اسکیم اور تعلیمی سپورٹ کا کام جاری ہے... ہم سب کو مل کر انسانیت کا ساتھ دینا ہے... ★★★
        </div>
    </div>

    <div class="container">
        
        <!-- فری اپلوڈ سیکشن -->
        <div class="free-hub">
            <h2>مفت براڈکاسٹنگ سسٹم</h2>
            <p style="color: #ccc; margin-top: 5px;">یہاں سے اپنی ویڈیو یا فائل سلیکٹ کریں اور اسے ٹیلی گرام کے ذریعے اپنے چینل پر لوڈ کریں:</p>
            
            <input type="file" id="mediaFile" class="file-input" accept="video/*,image/*"><br>
            <button class="btn-send" onclick="sendToTelegram()">ٹیلی گرام پر لوڈ کریں</button>
        </div>

        <h3 style="margin-bottom: 15px; color: #ffc107;">سوشل میڈیا لنکس</h3>
        
        <!-- 6 لنکس -->
        <div class="social-grid">
            <a href="https://facebook.com" target="_blank" class="social-btn">Facebook</a>
            <a href="https://youtube.com" target="_blank" class="social-btn">YouTube</a>
            <a href="https://tiktok.com" target="_blank" class="social-btn">TikTok</a>
            <a href="https://instagram.com" target="_blank" class="social-btn">Instagram</a>
            <a href="https://wa.me" target="_blank" class="social-btn">WhatsApp</a>
            <a href="https://threads.net" target="_blank" class="social-btn">Threads</a>
        </div>

    </div>

    <script>
        function sendToTelegram() {
            var fileInput = document.getElementById('mediaFile');
            if (fileInput.files.length === 0) {
                alert("براہ کرم پہلے کوئی ویڈیو یا تصویر منتخب کریں!");
                return;
            }
            
            // یہاں اپنا بوٹ ٹوکن پیسٹ کریں
            var botToken = "YOUR_BOT_TOKEN_HERE"; 
            var chatId = "@BunnSankersPage"; 
            var file = fileInput.files[0];
            
            var formData = new FormData();
            formData.append("chat_id", chatId);
            formData.append("document", file);

            fetch(`https://api.telegram.org/bot${botToken}/sendDocument`, {
                method: "POST",
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if(data.ok) {
                    alert("فائل کامیابی کے ساتھ ٹیلی گرام چینل پر اپلوڈ ہو گئی ہے!");
                } else {
                    alert("کنکشن کا مسئلہ: براہ کرم بوٹ ٹوکن درست کریں۔");
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("اپلوڈ کرنے میں کوئی مسئلہ پیش آیا ہے۔");
            });
        }
    </script>

</body>
</html>
