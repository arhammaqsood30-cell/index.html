<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دل جان 1400 آفیشل پورٹل</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #111;
            color: #fff;
            text-align: center;
            line-height: 1.6;
        }

        header {
            background-color: #0f5132;
            padding: 20px;
            border-bottom: 3px solid #ffc107;
        }

        .logo-area {
            font-size: 28px;
            font-weight: bold;
            color: #ffc107;
        }

        /* چلتی پٹی */
        .ticker-wrap {
            width: 100%;
            background-color: #ffc107;
            color: #000;
            overflow: hidden;
            white-space: nowrap;
            padding: 12px 0;
            font-weight: bold;
            font-size: 18px;
            border-bottom: 2px solid #0f5132;
            margin-bottom: 30px;
        }

        .ticker-content {
            display: inline-block;
            padding-right: 100%;
            animation: ticker 25s linear infinite;
        }

        @keyframes ticker {
            0% { transform: translate3d(100%, 0, 0); }
            100% { transform: translate3d(-100%, 0, 0); }
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        /* واٹس ایپ بٹن باکس */
        .wa-box {
            background: #222;
            border: 2px solid #ffc107;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 30px;
        }

        .btn-wa {
            display: inline-block;
            background-color: #25d366;
            color: white;
            padding: 15px 35px;
            border-radius: 30px;
            font-size: 18px;
            font-weight: bold;
            text-decoration: none;
            margin-top: 15px;
            transition: 0.2s;
        }

        .btn-wa:hover {
            transform: scale(1.05);
        }

        /* سوشل لنکس */
        .social-title {
            color: #ffc107;
            margin-bottom: 20px;
            font-size: 22px;
        }

        .social-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 15px;
            margin-bottom: 40px;
        }

        .social-btn {
            background-color: #222;
            border: 2px solid #444;
            color: #fff;
            padding: 18px 10px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            transition: 0.3s;
            display: block;
        }

        .social-btn:hover {
            background-color: #fff;
            color: #000;
            border-color: #fff;
        }

        footer {
            background: #000;
            padding: 20px;
            border-top: 1px solid #333;
            color: #888;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo-area">دل جان 1400 آفیشل پورٹل</div>
    </header>

    <!-- چلتی پٹی -->
    <div class="ticker-wrap">
        <div class="ticker-content">
            ★★★ دل جان 1400 ویلفیئر ٹرسٹ: غریب اور مستحقین کے لیے راشن اسکیم اور تعلیمی سپورٹ کا کام جاری ہے... خوش آمدید ★★★
        </div>
    </div>

    <div class="container">
        
        <!-- واٹس ایپ رابطہ سیکشن -->
        <div class="wa-box">
            <h2 style="color: #ffc107; margin-bottom: 10px;">ہم سے براہِ راست رابطہ کریں</h2>
            <p style="color: #ccc;">کسی بھی قسم کے سوال یا مدد کے لیے واٹس ایپ پر بٹن دبائیں:</p>
            <a href="https://wa.me/923430450007" target="_blank" class="btn-wa">واٹس ایپ پر بات کریں</a>
        </div>

        <h3 class="social-title">آفیشل لنکس</h3>
        
        <!-- 6 سوشل لنکس -->
        <div class="social-grid">
            <a href="https://facebook.com" target="_blank" class="social-btn">Facebook</a>
            <a href="https://youtube.com" target="_blank" class="social-btn">YouTube</a>
            <a href="https://tiktok.com" target="_blank" class="social-btn">TikTok</a>
            <a href="https://instagram.com" target="_blank" class="social-btn">Instagram</a>
            <a href="https://wa.me" target="_blank" class="social-btn">WhatsApp</a>
            <a href="https://threads.net" target="_blank" class="social-btn">Threads</a>
        </div>

    </div>

    <footer>
        <p>© 2026 دل جان 1400۔ تمام حقوق محفوظ ہیں۔</p>
    </footer>

</body>
</html>
