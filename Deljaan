index.html<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>دل جان 1400 | AI Platform</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,"Noto Nastaliq Urdu",sans-serif;
    background:#101010;
    color:#fff;
}

header{
    background:linear-gradient(135deg,#00ff6c,#00b84f);
    color:#000;
    padding:28px 15px;
    text-align:center;
}

header h1{
    margin:0;
    font-size:34px;
}

header p{
    margin:8px 0 0;
    font-size:17px;
}

.container{
    width:94%;
    max-width:950px;
    margin:25px auto;
}

.card{
    background:#1c1c1c;
    border:1px solid #333;
    border-radius:18px;
    padding:22px;
    margin-bottom:20px;
    box-shadow:0 5px 20px rgba(0,0,0,.35);
}

.card h2{
    color:#00ff6c;
    margin-top:0;
}

.card p{
    line-height:2;
    font-size:16px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:15px;
}

.box{
    background:#252525;
    border:1px solid #333;
    border-radius:14px;
    padding:22px;
    text-align:center;
}

.box strong{
    display:block;
    color:#00ff6c;
    font-size:28px;
    margin-bottom:8px;
}

.btn{
    display:block;
    width:90%;
    max-width:360px;
    margin:12px auto;
    padding:15px 20px;
    border:0;
    border-radius:12px;
    background:#00ff6c;
    color:#000;
    font-size:18px;
    font-weight:bold;
    text-decoration:none;
    cursor:pointer;
}

.btn:hover{
    background:#00d95b;
}

.status{
    background:#292929;
    border-radius:12px;
    padding:15px;
    margin-top:15px;
    color:#00ff6c;
    text-align:center;
}

#aiBox{
    display:none;
    margin-top:20px;
}

#question{
    width:100%;
    min-height:100px;
    background:#111;
    color:#fff;
    border:1px solid #444;
    border-radius:12px;
    padding:15px;
    font-size:16px;
    resize:vertical;
}

#answer{
    display:none;
    background:#292929;
    border-right:4px solid #00ff6c;
    padding:18px;
    margin-top:15px;
    border-radius:10px;
    line-height:2;
}

footer{
    background:#080808;
    color:#aaa;
    text-align:center;
    padding:28px 10px;
    margin-top:30px;
}

footer b{
    color:#00ff6c;
}

@media(max-width:600px){

    header h1{
        font-size:27px;
    }

    .card{
        padding:17px;
    }

    .btn{
        font-size:16px;
    }
}
</style>
</head>

<body>

<header>
    <h1>دل جان 1400</h1>
    <p>صحت • تعلیم • روزگار • عوامی خدمت</p>
</header>

<div class="container">

    <div class="card">
        <h2>🌟 دل جان 1400 میں خوش آمدید</h2>

        <p>
            دل جان 1400 ایک عوامی پلیٹ فارم ہے جس کا مقصد
            صحت، تعلیم، روزگار اور مفید معلومات عام لوگوں تک
            آسان انداز میں پہنچانا ہے۔
        </p>

        <div class="status">
            🟢 سسٹم آن لائن ہے
        </div>
    </div>


    <div class="card">

        <h2>📊 ہمارا پلیٹ فارم</h2>

        <div class="grid">

            <div class="box">
                <strong>01</strong>
                ❤️ صحت
            </div>

            <div class="box">
                <strong>02</strong>
                📚 تعلیم
            </div>

            <div class="box">
                <strong>03</strong>
                💼 روزگار
            </div>

            <div class="box">
                <strong>04</strong>
                🤝 عوامی خدمت
            </div>

        </div>

    </div>


    <div class="card">

        <h2>🤖 دل جان AI</h2>

        <p>
            دل جان AI کے ذریعے اپنا سوال لکھیں۔
            یہ AI پلیٹ فارم کا چیٹ انٹرفیس ہے۔
        </p>

        <button class="btn" onclick="openAI()">
            🤖 AI شروع کریں
        </button>

        <div id="aiBox">

            <textarea
                id="question"
                placeholder="اپنا سوال یہاں لکھیں..."
            ></textarea>

            <button class="btn" onclick="askAI()">
                🚀 سوال بھیجیں
            </button>

            <div id="answer"></div>

        </div>

    </div>


    <div class="card">

        <h2>📚 معلومات</h2>

        <p>
            صحت، تعلیم، روزگار اور معاشرتی مسائل کے بارے میں
            مفید معلومات ایک جگہ فراہم کرنے کی کوشش۔
        </p>

        <button class="btn" onclick="showInfo()">
            📖 معلومات دیکھیں
        </button>

        <div
            class="status"
            id="infoStatus"
            style="display:none;"
        ></div>

    </div>


    <div class="card">

        <h2>📞 رابطہ</h2>

        <p>
            اگر کسی معلومات کو سمجھنے میں مشکل ہو تو
            WhatsApp کے ذریعے رابطہ کریں۔
        </p>

        <a
            class="btn"
            href="https://wa.me/923430450007"
            target="_blank"
        >
            📱 WhatsApp رابطہ
        </a>

    </div>

</div>


<footer>

    <p>
        <b>دل جان 1400</b><br>
        عوام کے لیے، عوام کی خدمت کے لیے
    </p>

    <p>
        © 2026 Dil Jaan 1400
    </p>

</footer>


<script>

function openAI(){

    const aiBox = document.getElementById("aiBox");

    aiBox.style.display = "block";

    document.getElementById("question").focus();
}


function askAI(){

    const question =
        document.getElementById("question").value.trim();

    const answer =
        document.getElementById("answer");


    if(question === ""){

        answer.style.display = "block";

        answer.innerHTML =
            "⚠️ براہِ کرم پہلے اپنا سوال لکھیں۔";

        return;
    }


    answer.style.display = "block";

    answer.innerHTML =
        "🟢 آپ کا سوال موصول ہوگیا۔<br><br>" +
        "🤖 حقیقی AI جواب کے لیے محفوظ AI API " +
        "اور Backend کو اس ویب سائٹ کے ساتھ منسلک کرنا ضروری ہے۔<br><br>" +
        "📱 فوری رہنمائی کے لیے WhatsApp پر رابطہ کریں۔";
}


function showInfo(){

    const box =
        document.getElementById("infoStatus");

    box.style.display = "block";

    box.innerHTML =
        "✅ دل جان 1400 صحت، تعلیم، روزگار اور عوامی خدمت " +
        "سے متعلق مفید معلومات عام لوگوں تک پہنچانے کے لیے بنایا گیا ہے۔";
}

</script>

</body>
</html>
