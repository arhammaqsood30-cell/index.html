<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>دل جان 1400</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, "Noto Nastaliq Urdu", sans-serif;
    background: #121212;
    color: #fff;
}

header {
    background: linear-gradient(135deg, #00ff6c, #00c853);
    color: #000;
    padding: 25px 15px;
    text-align: center;
}

header h1 {
    margin: 0;
    font-size: 32px;
    font-weight: bold;
}

header p {
    margin: 8px 0 0;
    font-size: 17px;
}

.container {
    width: 95%;
    max-width: 900px;
    margin: 25px auto;
}

.card {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 15px;
    padding: 22px;
    margin-bottom: 20px;
    box-shadow: 0 5px 20px rgba(0,0,0,.35);
}

.card h2 {
    color: #00ff6c;
    margin-top: 0;
}

.card p {
    line-height: 1.9;
    font-size: 16px;
}

.btn {
    display: block;
    background: #00ff6c;
    color: #000;
    border: none;
    padding: 15px 20px;
    font-size: 18px;
    font-weight: bold;
    border-radius: 10px;
    cursor: pointer;
    margin: 12px auto;
    width: 90%;
    max-width: 350px;
    text-decoration: none;
}

.btn:hover {
    background: #00d95b;
}

.status {
    margin-top: 15px;
    padding: 15px;
    background: #292929;
    border-radius: 10px;
    color: #00ff6c;
    font-weight: bold;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 15px;
}

.box {
    background: #252525;
    padding: 20px;
    border-radius: 12px;
    text-align: center;
    border: 1px solid #333;
}

.box strong {
    display: block;
    font-size: 27px;
    color: #00ff6c;
    margin-bottom: 8px;
}

footer {
    text-align: center;
    padding: 25px 10px;
    background: #0b0b0b;
    color: #aaa;
    margin-top: 30px;
}

footer b {
    color: #00ff6c;
}

@media (max-width: 600px) {
    header h1 {
        font-size: 26px;
    }

    .card {
        padding: 17px;
    }

    .btn {
        font-size: 16px;
    }
}
</style>
</head>

<body>

<header>
    <h1>دل جان 1400</h1>
    <p>صحت • تعلیم • روزگار • خدمت</p>
</header>

<div class="container">

    <div class="card">
        <h2>🌟 ہمارے خواب میں خوش آمدید</h2>
        <p>
            دل جان 1400 ایک ایسا پلیٹ فارم ہے جس کا مقصد
            عام لوگوں تک صحت، تعلیم، روزگار اور مفید معلومات
            آسان انداز میں پہنچانا ہے۔
        </p>

        <div class="status" id="status">
            🟢 سسٹم آن لائن ہے
        </div>
    </div>

    <div class="card">
        <h2>📊 ہمارا پلیٹ فارم</h2>

        <div class="grid">
            <div class="box">
                <strong>01</strong>
                صحت
            </div>

            <div class="box">
                <strong>02</strong>
                تعلیم
            </div>

            <div class="box">
                <strong>03</strong>
                روزگار
            </div>

            <div class="box">
                <strong>04</strong>
                عوامی خدمت
            </div>
        </div>
    </div>

    <div class="card">
        <h2>🤖 دل جان AI</h2>

        <p>
            سوال پوچھیں، معلومات حاصل کریں اور اپنی ضرورت کے مطابق
            رہنمائی حاصل کریں۔
        </p>

        <button class="btn" onclick="startAI()">
            🤖 AI شروع کریں
        </button>

        <div class="status" id="aiStatus">
            AI ابھی شروع نہیں کیا گیا۔
        </div>
    </div>

    <div class="card">
        <h2>📚 معلومات</h2>

        <p>
            صحت، تعلیم، روزگار اور معاشرتی مسائل کے بارے میں
            مفید معلومات ایک جگہ فراہم کرنے کی کوشش۔
        </p>

        <button class="btn" onclick="showInfo()">
            معلومات دیکھیں
        </button>

        <div class="status" id="infoStatus" style="display:none;"></div>
    </div>

    <div class="card">
        <h2>📞 رابطہ</h2>

        <p>
            اگر کسی معلومات کو سمجھنے میں مشکل ہو تو ہم سے رابطہ کریں۔
        </p>

        <a class="btn" href="https://wa.me/923430450007" target="_blank">
            📱 WhatsApp رابطہ
        </a>
    </div>

</div>

<footer>
    <p>
        <b>دل جان 1400</b><br>
        عوام کے لیے، عوام کی خدمت کے لیے
    </p>

    <p>© 2026 Dil Jaan 1400</p>
</footer>

<script>

function startAI() {
    document.getElementById("aiStatus").innerHTML =
        "🟢 AI سسٹم تیار ہے — اپنا سوال پوچھنے کے لیے رابطہ کریں۔";
}

function showInfo() {
    const box = document.getElementById("infoStatus");

    box.style.display = "block";

    box.innerHTML =
        "✅ صحت، تعلیم، روزگار اور عوامی خدمت سے متعلق معلومات یہاں فراہم کی جائیں گی۔";
}

</script>

</body>
</html>
