}

nav a:hover{
    background:#00ff6c;
    color:#000;
}

.container{
    width:94%;
    max-width:1000px;
    margin:25px auto;
}

.card{
    background:#1c1c1c;
    border:1px solid #333;
    border-radius:18px;
    padding:24px;
    margin-bottom:20px;
    box-shadow:0 5px 20px rgba(0,0,0,.35);
}

.card h2{
    color:#00ff6c;
    margin-top:0;
}

.card p{
    font-size:17px;
    line-height:2;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
    gap:15px;
}

.box{
    background:#252525;
    border:1px solid #333;
    border-radius:14px;
    padding:24px 15px;
    text-align:center;
}

.box strong{
    display:block;
    color:#00ff6c;
    font-size:30px;
    margin-bottom:10px;
}

.btn{
    display:block;
    width:90%;
    max-width:380px;
    margin:15px auto;
    padding:16px 20px;
    background:#00ff6c;
    color:#000;
    border:0;
    border-radius:12px;
    font-size:18px;
    font-weight:bold;
    text-decoration:none;
    text-align:center;
    cursor:pointer;
}

.btn:hover{
    background:#00d95b;
}

.status{
    background:#292929;
    border-radius:12px;
    padding:15px;
    margin-top:15px;
    color:#00ff6c;
    text-align:center;
    line-height:1.8;
}

#aiPanel{
    display:none;
    margin-top:20px;
}

textarea{
    width:100%;
    min-height:120px;
    padding:15px;
    background:#111;
    color:#fff;
    border:1px solid #444;
    border-radius:12px;
    font-size:17px;
    outline:none;
    resize:vertical;
}

textarea:focus{
    border-color:#00ff6c;
}

#aiAnswer{
    display:none;
    margin-top:15px;
    padding:18px;
    background:#292929;
    border-right:4px solid #00ff6c;
    border-radius:10px;
    line-height:2;
}

.feature{
    margin:12px 0;
    padding:13px;
    background:#242424;
    border-radius:10px;
}

footer{
    background:#080808;
    color:#aaa;
    text-align:center;
    padding:30px 10px;
    margin-top:35px;
}

footer b{
    color:#00ff6c;
}

@media(max-width:600px){

