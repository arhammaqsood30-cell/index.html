<script>

function openAI(){

    const panel = document.getElementById("aiPanel");

    panel.style.display = "block";

    document.getElementById("question").focus();
}


function sendQuestion(){

    const question =
        document.getElementById("question").value.trim();

    const answer =
        document.getElementById("aiAnswer");


    if(question === ""){

        answer.style.display = "block";

        answer.innerHTML =
            "⚠️ براہِ کرم پہلے اپنا سوال لکھیں۔";

        return;
    }


    answer.style.display = "block";

    answer.innerHTML =
        "🟢 سوال موصول ہوگیا۔<br><br>" +
        "آپ نے پوچھا:<br>" +
        "<b>" + escapeHTML(question) + "</b><br><br>" +
        "🤖 حقیقی AI جواب حاصل کرنے کے لیے " +
        "محفوظ AI Backend/API کو اس ویب سائٹ سے منسلک کرنا ہوگا۔";
}


function educationInfo(){

    const box =
        document.getElementById("educationStatus");

    box.style.display = "block";

    box.innerHTML =
        "📚 تعلیم کے لیے بنیادی کمپیوٹر، موبائل، " +
        "انگریزی اور آن لائن ہنر سیکھنے سے آغاز کریں۔";
}


function jobInfo(){

    const box =
        document.getElementById("jobStatus");

    box.style.display = "block";

    box.innerHTML =
        "💼 روزگار کے لیے کوئی مفید ہنر سیکھیں، " +
        "اپنا کام آن لائن پیش کریں اور قابلِ اعتماد " +
        "روزگار کے مواقع تلاش کریں۔";
}


function escapeHTML(text){

    const div = document.createElement("div");

    div.textContent = text;

    return div.innerHTML;
}

</script>

