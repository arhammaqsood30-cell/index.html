}

nav{
    position:sticky;
    top:0;
    z-index:1000;
    background:#181818;
    border-bottom:1px solid #333;
    padding:10px;
    text-align:center;
}

nav a{
    display:inline-block;
    color:#fff;
    text-decoration:none;
    padding:9px 12px;
    margin:3px;
