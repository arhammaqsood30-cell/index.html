اگر آپ گٹ ہب (GitHub) کے لیے اپنے اس پروجیکٹ پر آگے کام کرنا چاہتے ہیں، تو مجھے بتائیے کہ اب اگلا قدم (Next Step) کیا ہے؟ ہم اس کوڈ میں مزید کیا شامل کریں یا آپ کو اگلا کون سا ٹاسک مکمل کرنا ہے؟






آپ کی ناراضگی اور غصہ بالکل بجا ہے، اور میں آپ کا وقت ضائع کرنے پر شرمندہ ہوں۔ پائتھون کوڈنگ میں ایک ایک لفظ اور لنک کی اہمیت ہوتی ہے، اور بار بار کوڈ بدلنے سے واقعی وقت برباد ہوتا ہے۔ آپ نے بالکل ٹھیک کہا کہ ان چیزوں میں ایسی غلطیوں کی گنجائش نہیں ہونی چاہیے۔
اب ہم اس مسئلے کو ایک ہی بار میں ہمیشہ کے لیے حل کر رہے ہیں۔ آپ کی ہدایت کے مطابق، میں نے اس کوڈ کے اندر وہ تمام فیچرز (لنکس، انٹرنیٹ چیکنگ، یوٹیوب اور ٹی وی چینل کے لنکس) ایک ساتھ شامل کر دیے ہیں جن کی آپ کو ضرورت ہے۔ اب آپ کو بار بار کوڈ بدلنے کی ضرورت نہیں پڑے گی۔
یہ رہا آپ کا مکمل، فائنل اور آل ان ون پائتھون کوڈ جو گٹ ہب (GitHub) پر اپ لوڈ کرنے کے لیے بالکل تیار ہے:
python
import webbrowser
import urllib.request

def check_internet():
    """انٹرنیٹ کنکشن چیک کرنے کے لیے"""
    try:
        urllib.request.urlopen('https://google.com', timeout=5)
        return True
    except:
        return False

def open_links():
    """انٹرنیٹ ایکٹیو ہونے پر یوٹیوب اور ٹی وی چینل کے لنکس کھولنے کے لیے"""
    print("\n--- انٹرنیٹ ایکٹیو ہے! لنکس لوڈ کیے جا رہے ہیں ---")
    
    # اپنے یوٹیوب اور ٹی وی چینل کے لنکس یہاں تبدیل کر سکتے ہیں
    youtube_url = "https://youtube.com"
    tv_channel_url = "https://live-tv-channel.com"
    
    print("یوٹیوب چینل کھولا جا رہا ہے...")
    webbrowser.open(youtube_url)
    
    print("ٹی وی چینل کھولا جا رہا ہے...")
    webbrowser.open(tv_channel_url)

def main():
    print("=== سسٹم اسٹارٹ ہو گیا ہے ===")
    print("برائے مہربانی اپنا سکور درج کریں:")
    user_input = input()
    
    try:
        score = int(user_input)
        if score >= 90:
            print("بہت اعلیٰ! آپ کا گریڈ A ہے")
        elif score >= 80:
            print("بہت خوب! آپ کا گریڈ B ہے")
        elif score >= 70:
            print("اچھا کام! آپ کا گریڈ C ہے")
        elif score >= 60:
            print("آپ کا گریڈ D ہے")
        else:
            print("محنت کی ضرورت ہے! آپ پاس نہیں ہو سکے")
            
        # گریڈ چیک کرنے کے بعد انٹرنیٹ اور لنکس کا سسٹم چلے گا
        if check_internet():
            open_links()
        else:
            print("\n[!] انٹرنیٹ کنکشن دستیاب نہیں ہے۔ لنکس نہیں کھولے جا سکتے۔")
            
    except ValueError:
        print("غلط اندراج! برائے مہربانی صرف نمبر لکھیں")

if __name__ == "__main__":
    main()
